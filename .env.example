# Local MongoDB Community Server (default for localhost development).
MONGODB_URI=mongodb://127.0.0.1:27017/foodhub
# Or use a free MongoDB Atlas cluster:
# MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/foodhub?retryWrites=true&w=majority

# Generate a unique value for each environment; never commit the real secret.
JWT_SECRET=<long-random-secret>

# Required when running the database seed script. Use a strong unique password.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-admin-password>

PORT=3000
NODE_ENV=development
